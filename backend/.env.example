PORT=5000
NODE_ENV=production
CORS_ORIGIN=https://your-storefront.vercel.app,https://your-admin.vercel.app

# PostgreSQL (Supabase)
# Transaction pooler (6543) — use for serverless/production API
DATABASE_URL="postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true"
# Session pooler (5432) — more stable for local Express dev (auto-used in development)
DIRECT_URL="postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres"
# Optional explicit runtime override for Prisma
# PRISMA_DATABASE_URL=""

# JWT Authentication Config
JWT_SECRET="airave@123454321@airave"
JWT_EXPIRES_IN="7d"

# Firebase Admin SDK Credentials (Optional for Push Notifications)
FIREBASE_PROJECT_ID="airave-8a552"
FIREBASE_CLIENT_EMAIL="firebase-adminsdk-fbsvc@airave-8a552.iam.gserviceaccount.com"
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n..."

# Supabase Storage Config
SUPABASE_URL="https://nnuzjdapofveowjrxtkp.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."
